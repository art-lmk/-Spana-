# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FASTAPI_RECOMMENDER_URL: Optional URL for external FastAPI recommendation microservice (e.g. from Google Colab ngrok / cloud service)
FASTAPI_RECOMMENDER_URL="http://localhost:8000/recommend"

# Mobile App Store Listing URLs (Optional: once published on Google Play / Apple App Store via TWA/Capacitor, badges link directly here)
VITE_PLAY_STORE_URL=""
VITE_APP_STORE_URL=""

